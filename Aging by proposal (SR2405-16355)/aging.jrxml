		<queryString language="SQL">
			<![CDATA[SELECT count(policy_number) as count
,SUM(aging_current_f) as toal_aging_current
,SUM(aging_30days_f) as total_aging_30days_f
,SUM(aging_60days_f) as aging_60days_f
,SUM(aging_90days_f) as aging_90days_f
,SUM(aging_120days_f) as aging_120days_f
,SUM(total_credit_f) as total_credit_f
,SUM(total_f) as total_f

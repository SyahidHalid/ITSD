	<parameter name="jholder_no" class="java.lang.String"/>
	<parameter name="policy_type" class="java.lang.String"/>
	<parameter name="date1" class="java.lang.String"/>
	<parameter name="date2" class="java.lang.String"/>
	<parameter name="policy_status" class="java.lang.String"/>
	<parameter name="title" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT [proposal_number]
      ,[company_no]
      ,[company_name]
      ,[ledger_bal]
      ,[last_modified_date]
      ,[rm_incharge]
      ,[approve_status]
      ,[recommend_status]
      ,[changes_status]
      ,[param_name]
      ,[param_code]
      ,[policy_type]
      ,[datetrans]
      ,[invoice_number]
      ,[debit]
      ,[credit]
      ,[policy_number]
      ,[os_fee]
      ,[os_premium]
      ,[os_sstgst]
      ,[os_yeancb]
      ,[statement_date]
      ,[aging_current]
      ,[aging_30days]
      ,[aging_60days]
      ,[aging_90days]
      ,[aging_120days]
 FROM [ecis09072026].[dbo].[statement_proposal]
 WHERE (CONVERT(date, statement_date, 105)  
 BETWEEN  (CONVERT(date, $P{date1}, 105) ) AND (CONVERT(date,  $P{date2}, 105)))
 	AND
 	 (policy_type LIKE  '%$P!{policy_type}%' OR   $P{policy_type} IS NULL)
 	AND 
 	(changes_status LIKE '%$P!{changes_status}%' OR   $P{changes_status} IS NULL)
 	AND 
 	(company_no LIKE  '%$P!{company_no}%' OR  $P{company_no} IS NULL)
ORDER BY [company_no] ASC
]]>
	</queryString>
